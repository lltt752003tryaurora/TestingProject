{{#> modal id='createModal'}}
<div class="d-flex flex-column p-4 gap-4">
  <div class="d-flex align-items-center justify-content-between">
    <div class="fw-semibold text-gray fs-3">
      Create new Test Run
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
  </div>
  
  <form id="create-testRun-form" class="needs-validation" onsubmit="return createTestRun(event)" novalidate>
    <div class="mb-3">
      <label for="name" class="form-label text-gray">Name</label>
      <input type="text" class="form-control" id="name" placeholder="Foobar" required>
      <div class="invalid-feedback">
        Please provide a valid name.
      </div>
    </div>
    <div class="mb-3">
      <label for="description" class="form-label text-gray">Test Case</label>
      <select id="testCase" class="form-select" required>
        <option value="" disabled selected>Test Case...</option>
      </select>
      <div class="invalid-feedback">
        Please choose test run.
      </div>
    </div>
    <div class="d-flex align-items-center justify-content-center gap-3">
      <button type="submit" class="btn btn-primary">Create</button>
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
    
  </form>
  
</div>
{{/modal}}

{{#> modal id='editModal'}}
<div class="d-flex flex-column p-4 gap-4">
  <div class="d-flex align-items-center justify-content-between">
    <div class="fw-semibold text-gray fs-3">
      Edit Test Run
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
  </div>
  
  <form id="edit-testRun-form" class="needs-validation" onsubmit="return editTestRun(event)" novalidate>
    <div class="mb-3">
      <label for="name" class="form-label text-gray">Name</label>
      <input type="text" class="form-control" id="name" placeholder="Foobar" required>
      <div class="invalid-feedback">
        Please provide a valid name.
      </div>
    </div>
    <div class="mb-3">
      <input type="text" class="form-control" id="id" hidden required>
    </div>
    <div class="d-flex align-items-center justify-content-center gap-3">
      <button type="submit" class="btn btn-primary">Edit</button>
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
  </form>
  
</div>
{{/modal}}

{{#> modal id='deleteModal'}}
<div class="d-flex flex-column p-4 gap-4">
  <div class="d-flex align-items-center justify-content-between">
    <div class="fw-semibold text-gray fs-3">
      Delete Test Run
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
  </div>
  
  <form id="delete-testRun-form" class="needs-validation" onsubmit="return deleteTestRun(event)" novalidate>
    <div class="mb-3">
      <input type="text" class="form-control" id="id" hidden required>
      Are you sure you want to delete this test run?
    </div>
    <div class="d-flex align-items-center justify-content-center gap-3">
      <button type="submit" class="btn btn-danger">Delete</button>
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
  </form>
  
</div>
{{/modal}}

<main class="d-flex h-100 overflow-hidden">
  {{>sidebar}}
  <div id="content" class="h-100 overflow-auto p-4" style="width: 80%; ">
    <button type="button" class="btn btn-success d-flex align-items-center mb-3" data-bs-toggle="modal" data-bs-target="#createModal">
      <i class="bi bi-plus-lg text-white h5 m-0"></i>
      <div>Add Test Run</div>
    </button>
    <div id="testRuns" class="d-grid gap-2 project-grid-cols-1 sm:project-grid-cols-2 md:project-grid-cols-4">
    </div>
  </div>
</main>

{{{{rawHelper}}}}
<script id="template-testRun" type="text/x-handlebars-template">
	{{#each data}}
    <a href="" class="text-decoration-none d-flex flex-column bg-white rounded bottom-shadow p-3">
      <div class="d-flex justify-content-between align-items-center minw-0">
        <div class="text-gray fw-semibold fs-5 text-truncate">
          {{name}}
        </div>
        <div class="d-flex gap-1">
          <button class="btn p-0" onclick="openEditModal(event, {{id}}, '{{name}}')" data-bs-toggle="modal" data-bs-target="#editModal">
            <i class="bi bi-pencil-fill text-gray"></i>
          </button>
          <button class="btn p-0" onclick="openDeleteModal(event, {{id}})" data-bs-toggle="modal" data-bs-target="#deleteModal">
            <i class="bi bi-trash3-fill text-gray"></i>
          </button>
        </div>
      </div>
    </a>
    {{else}}
    <div id="content-empty" style="grid-column: 1/-1">
      <div class="d-flex flex-column align-items-center justify-content-center mt-5">
        <img src="/assets/empty_box.png" height="140px" width="140px" />
        <div class="fw-semibold fs-2" style="color: #9FAAC0">It’s empty. Create something new</div>
      </div>
    </div>
	{{/each}}
</script>
{{{{/rawHelper}}}}

{{{{rawHelper}}}}
<script id="template-testCase-select" type="text/x-handlebars-template">
	{{#each testCases}}
    <option value="{{id}}">{{name}}</option>
	{{/each}}
</script>
{{{{/rawHelper}}}}

<script>
let template_testRun = Handlebars.compile(document.getElementById('template-testRun').innerHTML);
let template_testCase_select = Handlebars.compile(document.getElementById('template-testCase-select').innerHTML);

function populateTestCase() {
  axiosAPI.get('/api/projects/{{projectId}}/testCases')
  .then(res => {
    let select = template_testCase_select({
      testCases: res.data.testCases
    })
    document.querySelector('#create-testRun-form #testCase').innerHTML += select;
  })
  .catch(err => {
    console.log(err);
  })
}
populateTestCase();

function loadTestRuns() {
  axiosAPI.get('/api/projects/{{projectId}}/testRuns')
  .then(res => {
      res.data.testRuns.forEach((re, i) => {
      })
      let html = template_testRun({
        data: res.data.testRuns,
      })
      document.getElementById('testRuns').innerHTML += html;
  })
  .catch(err => {
    console.log(err);
  })
}
loadTestRuns();

function createTestRun(e) {
  e.preventDefault()
	e.stopPropagation()
	var form = document.getElementById('create-testRun-form');
	if (!form.checkValidity()) {
		form.classList.add('was-validated')
		return;
	}
	form.classList.remove('was-validated')

	var myModalEl = document.getElementById('createModal');
	var modal = bootstrap.Modal.getInstance(myModalEl);
	
	var name = document.querySelector("#create-testRun-form #name");
	var testCase = document.querySelector("#create-testRun-form #testCase");

	axiosAPI.post('/api/projects/{{projectId}}/testRuns/', {
		name: name.value,
    testCaseId: testCase.value,
	})
	.then(res => {
		console.log(res);
		Toastify({
			text: "Succesfully created test run",
			style: {
			background: "linear-gradient(to right, #198754, #198754)",
			},
			onClick: function(){} // Callback after click
		}).showToast();
		modal.hide();
    
    //Clear form
    name.value = "";
    testCase.value = "";
		setTimeout(() => {
			window.location.reload();
		}, 500);
	})
	.catch(err => {
		console.log(err);
		Toastify({
			text: "Failed to create test run",
			style: {
			background: "linear-gradient(to right, #dc3545, #dc3545)",
			},
			onClick: function(){} // Callback after click
		}).showToast();
	})
}

function openEditModal(e, id, name) {
  e.preventDefault();
  e.stopPropagation();
  document.querySelector("#edit-testRun-form #id").value = id;
  document.querySelector("#edit-testRun-form #name").value = name;
}

function openDeleteModal(e, id) {
  e.preventDefault();
  e.stopPropagation();
  document.querySelector("#delete-testRun-form #id").value = id;
}

function editTestRun(e) {
  e.preventDefault()
	e.stopPropagation()
	var form = document.getElementById('edit-testRun-form');
	if (!form.checkValidity()) {
		form.classList.add('was-validated')
		return;
	}
	form.classList.remove('was-validated')

	var myModalEl = document.getElementById('editModal');
	var modal = bootstrap.Modal.getInstance(myModalEl);
	
	var id = document.querySelector("#edit-testRun-form #id");
	var name = document.querySelector("#edit-testRun-form #name");

	axiosAPI.put('/api/projects/{{projectId}}/testRuns/' + id.value, {
		name: name.value,
	})
	.then(res => {
		console.log(res);
		Toastify({
			text: "Succesfully edited test run",
			style: {
			background: "linear-gradient(to right, #198754, #198754)",
			},
			onClick: function(){} // Callback after click
		}).showToast();
		modal.hide();
    
    //Clear form
    id.value = "";
    name.value = "";
		setTimeout(() => {
			window.location.reload();
		}, 500);
	})
	.catch(err => {
		console.log(err);
		Toastify({
			text: "Failed to change test run",
			style: {
			background: "linear-gradient(to right, #dc3545, #dc3545)",
			},
			onClick: function(){} // Callback after click
		}).showToast();
	})
}

function deleteTestRun(e) {
  e.preventDefault()
  e.stopPropagation();

  var myModalEl = document.getElementById('deleteModal');
	var modal = bootstrap.Modal.getInstance(myModalEl);
	
	var id = document.querySelector("#delete-testRun-form #id");

  axiosAPI.delete('/api/projects/{{projectId}}/testRuns/' + id.value)
    .then(res => {
      console.log(res);
      Toastify({
        text: "Successfully deleted test run",
        style: {
        background: "linear-gradient(to right, #198754, #198754)",
        },
        onClick: function(){} // Callback after click
      }).showToast();
      setTimeout(() => {
        window.location.reload();
      }, 500);
    })
    .catch(err => {
      console.log(err);
      Toastify({
        text: "Failed to delete test run",
        style: {
        background: "linear-gradient(to right, #dc3545, #dc3545)",
        },
        onClick: function(){} // Callback after click
      }).showToast();
    })
}


</script>
