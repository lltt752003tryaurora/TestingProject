{{{{rawHelper}}}}
<script id="template-module" type="text/x-handlebars-template">
	{{#with module}}
    <div class="{{collapse}}" id="{{parentStr}}" onclick="toggleArrowShape(this);">
      <div class="d-flex align-items-center justify-content-between gap-2" data-bs-toggle="collapse" data-bs-target="{{target}}">
        <button class="btn p-0 d-flex align-items-center gap-2 w-100 minw-0 border-0">
          {{#times level}}
            <img src="/assets/arrow_none.png" height="20px" />
          {{/times}}
          <img class="arrow {{childless}}" src="{{arrowImg}}" height="20px" />
          <img src="/assets/folder.png" height="30px" />
          <div class="text-gray fw-semibold text-truncate">{{name}}</div>
        </button>
        <button class="btn p-0" onclick="openRenameModal(event, {{id}}, '{{name}}')" data-bs-toggle="modal" data-bs-target="#renameModule">
          <i class="bi bi-pencil-fill text-gray"></i>
        </button>
        <button class="btn p-0" onclick="openDeleteModal(event, {{id}})" data-bs-toggle="modal" data-bs-target="#deleteModule">
          <i class="bi bi-trash3-fill text-gray"></i>
        </button>
      </div>
		</div>
	{{/with}}
</script>
{{{{/rawHelper}}}}


<script>
let template_module = Handlebars.compile(document.getElementById('template-module').innerHTML);
let toRenameId = 0;

function resolveChild(modules, child) {
  let tree = [];
  child.forEach(ch => {
    let m = modules.filter(m => m.id == ch.id)[0];
    tree.push({
      id: m.id,
      name: m.name,
      child: resolveChild(modules, m.childModules),
    })
  })
  return tree;
}

function buildTree(modules) {
  let tree = [];
  modules.forEach(m => {
    if (m.parentModuleId == null) {
      tree.push({
        id: m.id,
        name: m.name,
        child: resolveChild(modules, m.childModules)
      })
    }
  })
  return tree;
}

function loadModules() {
  axiosAPI.get('/api/projects/{{projectId}}/modules')
  .then(res => {
    let tree = buildTree(res.data.modules);
    console.log(tree)
    renderModules(tree);
  })
  .catch(err => {
    console.log(err);
    if (err.response.data.message == 'Access denied.') {
      alert("Your role isn't allowed to view this page")
      window.location.replace("/project/{{projectId}}/");
    }
  })
}

loadModules();

function createModule(e) {
	e.preventDefault()
	e.stopPropagation()
	var form = document.getElementById('create-module-form');
	if (!form.checkValidity()) {
		form.classList.add('was-validated')
		return;
	}
	form.classList.remove('was-validated')

	var myModalEl = document.getElementById('createModule');
	var modal = bootstrap.Modal.getInstance(myModalEl);
	
	var name = document.querySelector("#create-module-form #name");

	axiosAPI.post('/api/projects/{{projectId}}/modules', {
		name: name.value,
	})
	.then(res => {
		console.log(res);
		Toastify({
			text: "New module created",
			style: {
			background: "linear-gradient(to right, #198754, #198754)",
			},
			onClick: function(){} // Callback after click
		}).showToast();
		modal.hide();

    //Clear form
    name.value = "";
		setTimeout(() => {
			window.location.reload();
		}, 500);
	})
	.catch(err => {
		console.log(err);
		Toastify({
			text: "Failed to create module",
			style: {
			background: "linear-gradient(to right, #dc3545, #dc3545)",
			},
			onClick: function(){} // Callback after click
		}).showToast();
	})
}

function openRenameModal(e, id, name) {
  e.preventDefault();
  e.stopPropagation();
  document.querySelector("#edit-module-form #name").value = name;
  document.querySelector("#edit-module-form #id").value = id;
}

function openDeleteModal(e, id) {
  e.preventDefault();
  e.stopPropagation();
  document.querySelector("#delete-module-form #id").value = id;
}

function renameModule(e, id) {
  e.preventDefault()
	e.stopPropagation()
	var form = document.getElementById('edit-module-form');
	if (!form.checkValidity()) {
		form.classList.add('was-validated')
		return;
	}
	form.classList.remove('was-validated')

	var myModalEl = document.getElementById('renameModule');
	var modal = bootstrap.Modal.getInstance(myModalEl);
	
	var name = document.querySelector("#edit-module-form #name");
	var id = document.querySelector("#edit-module-form #id");

	axiosAPI.put('/api/projects/{{projectId}}/modules/' + id.value, {
		name: name.value,
	})
	.then(res => {
		console.log(res);
		Toastify({
			text: "Module renamed",
			style: {
			background: "linear-gradient(to right, #198754, #198754)",
			},
			onClick: function(){} // Callback after click
		}).showToast();
		modal.hide();
    
    //Clear form
    name.value = "";
    id.value = "";
		setTimeout(() => {
			window.location.reload();
		}, 500);
	})
	.catch(err => {
		console.log(err);
		Toastify({
			text: "Failed to rename module",
			style: {
			background: "linear-gradient(to right, #dc3545, #dc3545)",
			},
			onClick: function(){} // Callback after click
		}).showToast();
	})
}

function deleteModule(e, id) {
  e.preventDefault()
  e.stopPropagation();

  var myModalEl = document.getElementById('deleteModule');
	var modal = bootstrap.Modal.getInstance(myModalEl);
	
	var id = document.querySelector("#delete-module-form #id");

  axiosAPI.delete('/api/projects/{{projectId}}/modules/' + id.value)
    .then(res => {
      console.log(res);
      Toastify({
        text: "Deleted module",
        style: {
        background: "linear-gradient(to right, #198754, #198754)",
        },
        onClick: function(){} // Callback after click
      }).showToast();
      modal.hide();
      id.value = '';
      setTimeout(() => {
        window.location.reload();
      }, 500);
    })
    .catch(err => {
      console.log(err);
      Toastify({
        text: "Failed to delete module",
        style: {
        background: "linear-gradient(to right, #dc3545, #dc3545)",
        },
        onClick: function(){} // Callback after click
      }).showToast();
    })
}

function isEmpty(obj) {
	for (const prop in obj) {
		if (Object.hasOwn(obj, prop)) {
			return false;
		}
	}
  
	return true;
}

function toggleArrowShape(self) {
	var arrowEl = self.getElementsByClassName('arrow')[0];
	if (arrowEl.classList.contains('childless'))
		return;
	if (arrowEl.classList.contains('expanded')) {
		arrowEl.src = '/assets/arrow_down.png';
		arrowEl.classList.remove('expanded');
	}
	else {
		arrowEl.src = '/assets/arrow_right.png';
		arrowEl.classList.add('expanded');
	}
}

function renderSubmodule(submodule, parentStr, rootElement, level) {
  submodule.forEach(sm => {
    const hasNoChildren = !sm.child.length;// isEmpty(submodule[key]);
		const newParent = parentStr + sm.name;
    const module = {};
    module.collapse = level > 0 ? 'collapse' : '';
    module.parentStr = parentStr;
    module.target = hasNoChildren ? '' : '#' + newParent;
    module.level = level;
    module.childless = hasNoChildren ? 'childless' : '';
    module.arrowImg = hasNoChildren ? '/assets/arrow_none.png' : '/assets/arrow_down.png';
    module.name = sm.name;
    module.id = sm.id;
    let newEl = template_module({
        module: module,
    })
		rootElement.innerHTML += newEl;

		if (!hasNoChildren) {
			renderSubmodule(sm.child, newParent, rootElement, level + 1);
		}
  })
}

function renderModules(tree) {
	var modulesDiv = document.getElementById('modules');

	renderSubmodule(tree, '', modulesDiv, 0);
}
</script>
