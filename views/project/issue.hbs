<script>
const loadTable = (tableData) => {
  const tableBody = document.getElementById("table-body");
  tableBody.innerHTML = "";

  tableData.forEach(data => {
    // Create a new row
    const row = document.createElement("tr");

    // Create a cell for each data item
    const checkboxCell = document.createElement("td");
    const idCell = document.createElement("td");
    const titleCell = document.createElement("td");
    const createdByCell = document.createElement("td");
    const assignedToCell = document.createElement("td");
    const statusCell = document.createElement("td");
    const priorityCell = document.createElement("td");
    const createdDateCell = document.createElement("td");
    const actionCell = document.createElement("td");

    // Checkbox
    checkboxCell.style.textAlign = "center";

    // Set the innerHTML of each cell
    checkboxCell.innerHTML = `<input type="checkbox">`;
    titleCell.textContent = data.name;
    statusCell.textContent = data.status;
    priorityCell.textContent = data.priority;
    createdDateCell.textContent = dayjs(data.createdAt).format('DD/MM/YYYY');

    // ID
    idCell.style.textAlign = "center";
    const url = document.createElement("a");
    url.innerText = data.id;
    url.href = `/project/{{projectId}}/issue/${data.id}`;
    idCell.appendChild(url);

    // Created by
    createdByCell.style.textAlign = "center";
    createdByCell.innerText = data?.creator?.fullName;

    {{!-- const createdByAvatar = document.createElement("img");
    createdByAvatar.src = users[data.createdBy].avatar;
    createdByAvatar.classList.add("rounded-circle");
    createdByAvatar.style.maxHeight = "25px";
    createdByCell.appendChild(createdByAvatar); --}}

    // Assigned to
    assignedToCell.style.textAlign = "center";
    assignedToCell.innerText = data?.assigned?.fullName ?? 'Unassigned';

    {{!-- const assignedToAvatar = document.createElement("img");
    assignedToAvatar.src = users[data.assignedTo].avatar;
    assignedToAvatar.classList.add("rounded-circle");
    assignedToAvatar.style.maxHeight = "25px";
    assignedToCell.appendChild(assignedToAvatar); --}}

    // Status
    statusCell.style.textAlign = "center";
    if (data.status === "open") {
      statusCell.classList.add("text-primary");
    } else if (data.status === "closed") {
      statusCell.classList.add("text-secondary");
    }

    // Priority
    priorityCell.style.textAlign = "center";
    if (data.priority === "high") {
      priorityCell.classList.add("text-danger");
    } else if (data.priority === "medium") {
      priorityCell.classList.add("text-warning");
    } else if (data.priority === "low") {
      priorityCell.classList.add("text-success");
    }

    actionCell.innerHTML = `
    <div class="d-flex justify-content-center">
      <div class="d-flex gap-1">
        <button class="btn p-0" onclick="openEditModal(event, ${data.id}, '${data.name}', '${data.description}', '${data.priority}', '${data.status}')" data-bs-toggle="modal" data-bs-target="#editModal">
          <i class="bi bi-pencil-fill text-gray"></i>
        </button>
        <button class="btn p-0" onclick="openDeleteModal(event, ${data.id})" data-bs-toggle="modal" data-bs-target="#deleteModal">
          <i class="bi bi-trash3-fill text-gray"></i>
        </button>
      </div>
    </div>
    `

    // Append cells to the row
    createdDateCell.style.textAlign = "center";
    row.appendChild(checkboxCell);
    row.appendChild(idCell);
    row.appendChild(titleCell);
    row.appendChild(createdByCell);
    row.appendChild(assignedToCell);
    row.appendChild(statusCell);
    row.appendChild(priorityCell);
    row.appendChild(createdDateCell);
    row.appendChild(actionCell);

    // Append row to table body
    tableBody.appendChild(row);
  })
}
  
let template_pagination = Handlebars.compile(document.getElementById('template-pagination').innerHTML);
let template_testRun_select = Handlebars.compile(document.getElementById('template-testRun-select').innerHTML);

let currentPage = parseInt(getUrlQuery('page')) || 1;
currentPage = currentPage > 0 ? currentPage : 1;

let currentFilter = '';
let currentSearch = '';

function loadIssue(page = 1, size = 10) {
  axiosAPI.get(`/api/projects/{{projectId}}/issues`, {
    params: {
      page: page,
      size: size,
      filter: currentFilter,
      search: currentSearch,
    }
  })
  .then((response) => {
    loadTable(response.data.issues);
    makePagination(response.data.numPage, page);
  })
  .catch((err) => {
    console.log(err);
  })
}

loadIssue(1);

function makePagination(numPage, currentPage) {
	let opts = [];

	let start = currentPage - 2;
	let end = currentPage + 2;

	if (start < 1) {
		start = 1
		end = Math.min(numPage, 5)
	}
	else if (end > numPage) {
		end = numPage
		start = Math.max(1, numPage - 4)
	}
	
	for (let i = start; i <= end; i++) {
		opts.push({
			text: i,
			onclick: `loadIssue(${i})`,
			currentPage: currentPage == i
		})
	}

	let html = template_pagination({
		currentPage: currentPage,
		pages: opts
	})
	document.getElementById('pagination').innerHTML = html;
	document.getElementById('previousPage').onclick = currentPage == 1 ? null : () => {loadIssue(currentPage - 1)};
	document.getElementById('nextPage').onclick = currentPage == numPage ? null : () => {loadIssue(currentPage + 1)};
}

function searchOnInput() {
	let keyword = document.getElementById('search').value;
	currentSearch = keyword;
	loadIssue(1);
}

</script>

<script>
function populateTestRun() {
  axiosAPI.get('/api/projects/{{projectId}}/testRuns')
  .then(res => {
    let select = template_testRun_select({
      testRuns: res.data.testRuns
    })
    document.querySelector('#create-issue-form #testRun').innerHTML += select;
  })
  .catch(err => {
    console.log(err);
  })
}
populateTestRun();

function createIssue(e) {
  e.preventDefault()
	e.stopPropagation()
	var form = document.getElementById('create-issue-form');
	if (!form.checkValidity()) {
		form.classList.add('was-validated')
		return;
	}
	form.classList.remove('was-validated')

	var myModalEl = document.getElementById('createModal');
	var modal = bootstrap.Modal.getInstance(myModalEl);

	var name = document.getElementById('name');
	var description = document.getElementById('description');
	var priority = document.getElementById('priority');
	var testRunId = document.getElementById('testRun');

  axiosAPI.post('/api/projects/{{projectId}}/issues', {
    name: name.value,
    description: description.value,
    priority: priority.value,
    status: 'open',
    testRunId: testRunId.value,
  })
  .then(res => {
		console.log(res);
		Toastify({
			text: "New issue created",
			style: {
			background: "linear-gradient(to right, #198754, #198754)",
			},
			onClick: function(){} // Callback after click
		}).showToast();
		modal.hide();

    //Clear form
    name.value = "";
    description.value = "";
    priority.value = "";
    testRunId.value = "";
		setTimeout(() => {
			window.location.reload();
		}, 500);
	})
	.catch(err => {
		console.log(err);
		Toastify({
			text: "Failed to create issue",
			style: {
			background: "linear-gradient(to right, #dc3545, #dc3545)",
			},
			onClick: function(){} // Callback after click
		}).showToast();
	})
}

function openEditModal(e, id, name, description, priority, status) {
  e.preventDefault();
  e.stopPropagation();
  document.querySelector("#edit-issue-form #id").value = id;
  document.querySelector("#edit-issue-form #name").value = name;
  document.querySelector("#edit-issue-form #description").value = description;
  document.querySelector("#edit-issue-form #priority").value = priority;
  document.querySelector("#edit-issue-form #status").value = status;
}
function editIssue(e) {
  e.preventDefault()
  e.stopPropagation();

  var myModalEl = document.getElementById('editModal');
	var modal = bootstrap.Modal.getInstance(myModalEl);
	
	var id = document.querySelector("#edit-issue-form #id");
	var name = document.querySelector("#edit-issue-form #name");
	var description = document.querySelector("#edit-issue-form #description");
	var priority = document.querySelector("#edit-issue-form #priority");
	var status = document.querySelector("#edit-issue-form #status");

  axiosAPI.put('/api/projects/{{projectId}}/issues/' + id.value, {
    name: name.value,
    description: description.value,
    priority: priority.value,
    status: status.value
  })
    .then(res => {
      console.log(res);
      Toastify({
        text: "Successfully edited issue",
        style: {
        background: "linear-gradient(to right, #198754, #198754)",
        },
        onClick: function(){} // Callback after click
      }).showToast();
      setTimeout(() => {
        window.location.reload();
      }, 500);
    })
    .catch(err => {
      console.log(err);
      Toastify({
        text: "Failed to edit issue",
        style: {
        background: "linear-gradient(to right, #dc3545, #dc3545)",
        },
        onClick: function(){} // Callback after click
      }).showToast();
    })
}


function openDeleteModal(e, id) {
  e.preventDefault();
  e.stopPropagation();
  document.querySelector("#delete-issue-form #id").value = id;
}

function deleteIssue(e) {
  e.preventDefault()
  e.stopPropagation();

  var myModalEl = document.getElementById('deleteModal');
	var modal = bootstrap.Modal.getInstance(myModalEl);
	
	var id = document.querySelector("#delete-issue-form #id");

  axiosAPI.delete('/api/projects/{{projectId}}/issues/' + id.value)
    .then(res => {
      console.log(res);
      Toastify({
        text: "Successfully deleted issue",
        style: {
        background: "linear-gradient(to right, #198754, #198754)",
        },
        onClick: function(){} // Callback after click
      }).showToast();
      setTimeout(() => {
        window.location.reload();
      }, 500);
    })
    .catch(err => {
      console.log(err);
      Toastify({
        text: "Failed to delete issue",
        style: {
        background: "linear-gradient(to right, #dc3545, #dc3545)",
        },
        onClick: function(){} // Callback after click
      }).showToast();
    })
}


</script>

