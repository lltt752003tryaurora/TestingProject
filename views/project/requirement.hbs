{{#> modal id='createModal'}}
<div class="d-flex flex-column p-4 gap-4">
  <div class="d-flex align-items-center justify-content-between">
    <div class="fw-semibold text-gray fs-3">
      Create new Requirement
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
  </div>

  
  <form id="create-requirement-form" class="needs-validation" onsubmit="return createRequirement(event)" novalidate>
    <div class="mb-3">
      <label for="name" class="form-label text-gray">Requirement Name</label>
      <input type="text" class="form-control" id="name" placeholder="Foobar" required>
      <div class="invalid-feedback">
        Please provide a valid name.
      </div>
    </div>
    <div class="mb-3">
      <label for="description" class="form-label text-gray">Requirement Description</label>
      <textarea class="form-control" id="description" rows="5" placeholder="Something about this requirement..."></textarea>
    </div>
    <div class="mb-3">
      <input type="text" class="form-control" id="parentRequirementId" hidden required value="{{requirementId}}">
    </div>
    <div class="mb-3">
      <label for="release" class="form-label text-gray">Release</label>
      <select class="form-select" id="release" required>
        <option value="" disabled selected>Release...</option>
      </select>
      <div class="invalid-feedback">
        Please select a release.
      </div>
    </div>
    <div class="d-flex align-items-center justify-content-center gap-3">
      <button type="submit" class="btn btn-primary">Create</button>
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
  </form>
  
</div>
{{/modal}}

{{#> modal id='editModal'}}
<div class="d-flex flex-column p-4 gap-4">
  <div class="d-flex align-items-center justify-content-between">
    <div class="fw-semibold text-gray fs-3">
      Edit Requirement
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
  </div>
  
  <form id="edit-requirement-form" class="needs-validation" onsubmit="return editRequirement(event)" novalidate>
    <div class="mb-3">
      <label for="name" class="form-label text-gray">Requirement Name</label>
      <input type="text" class="form-control" id="name" placeholder="Foobar" required>
      <div class="invalid-feedback">
        Please provide a valid name.
      </div>
    </div>
    <div class="mb-3">
      <label for="description" class="form-label text-gray">Requirement Description</label>
      <textarea class="form-control" id="description" rows="5" placeholder="Something about this requirement..."></textarea>
    </div>
    <div>
      <input type="text" class="form-control" id="id" hidden required>
    </div>
    <div class="d-flex align-items-center justify-content-center gap-3">
      <button type="submit" class="btn btn-primary">Edit</button>
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
  </form>
</div>
{{/modal}}

{{#> modal id='deleteModal'}}
<div class="d-flex flex-column p-4 gap-4">
  <div class="d-flex align-items-center justify-content-between">
    <div class="fw-semibold text-gray fs-3">
      Delete Requirement
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
  </div>
  
  <form id="delete-requirement-form" class="needs-validation" onsubmit="return deleteRequirement(event)" novalidate>
    <div class="mb-3">
      <input type="text" class="form-control" id="id" hidden required>
      Are you sure you want to delete this requirement?
    </div>
    <div class="d-flex align-items-center justify-content-center gap-3">
      <button type="submit" class="btn btn-danger">Delete</button>
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
  </form>
</div>
{{/modal}}

<main class="d-flex h-100 overflow-hidden">
  {{>sidebar}}
  <div id="content" class="h-100 overflow-auto p-4" style="width: 80%; ">

    <div class="text-gray fw-semibold fs-4 pb-3">
      {{#if requirementId}}
      <a id="back" class="text-decoration-none">
        <i class="bi bi-caret-left-fill text-gray"></i>
      </a>
      {{/if}}
			Requirements {{requirementId}}
		</div>
    <button type="button" class="btn btn-success d-flex align-items-center" data-bs-toggle="modal" data-bs-target="#createModal">
      <i class="bi bi-plus-lg text-white h5 m-0"></i>
      <div>Add Requirements</div>
    </button>
		<div class="d-flex justify-content-end pb-3">
			<div class="d-flex gap-1">
				<div class="input-group">
					<input type="text" class="rounded-pill form-control" id="search" placeholder="Search" oninput="searchOnInput()"/>
					<label for="search" class="position-absolute end-0 pe-2 me-0 d-flex align-items-center h-100" style="z-index: 1000;">
						<i class="bi bi-search text-gray h6 m-0"></i>
					</label>
				</div>
				<div class="btn-group">
					<button class="btn p-0 border-0" data-bs-toggle="dropdown">
						<i class="bi bi-funnel text-gray h4"></i>
					</button>
					<div class="dropdown-menu dropdown-menu-right" id="filter">
            <h6 class="dropdown-header">Release</h6>
						<button class="dropdown-item" onclick="currentFilter = ''; loadRequirement(1)">All</button>
					</div>
				</div>
			</div>
		</div>

    <div id="requirements" class="d-grid gap-2 project-grid-cols-1 sm:project-grid-cols-2 md:project-grid-cols-4">
    </div>

    <div class="d-flex justify-content-end align-items-center text-gray mt-4 mr-2 gap-1">
			<button class="btn p-0" id="previousPage">
				<i class="bi bi-chevron-left h4 m-0"></i>
			</button>
			<div class="d-flex gap-1" id="pagination">
				
			</div>
			<button class="btn p-0" id="nextPage">
				<i class="bi bi-chevron-right h4 m-0"></i>
			</button>
		</div>

    <div id="testCases" class="d-grid gap-2 project-grid-cols-1 sm:project-grid-cols-2 md:project-grid-cols-4">
    </div>
  </div>
</main>

{{{{rawHelper}}}}
<script id="template-pagination" type="text/x-handlebars-template">
	{{#each pages}}
	<button class="btn p-0" onclick="{{onclick}}">
		<div class="d-flex rounded-circle {{#if currentPage}}bg-simple-gray{{/if}} justify-content-center align-items-center" style="width: 40px; height: 40px;">
			<span class="lh-1 h6 m-0">
				{{text}}
			</span>
		</div>
	</button>
	{{/each}}
</script>
{{{{/rawHelper}}}}

{{{{rawHelper}}}}
<script id="template-requirement" type="text/x-handlebars-template">
	{{#each data}}
    <a href="/project/{{projectId}}/requirement/{{id}}" class="text-decoration-none d-flex flex-column bg-white rounded bottom-shadow p-3">
      <div class="d-flex justify-content-between align-items-center pb-2 minw-0">
        <div class="text-gray fw-semibold fs-5 text-truncate">
          {{name}}
        </div>
        <div class="d-flex gap-1">
          <button class="btn p-0" onclick="openEditModal(event, {{id}}, '{{name}}', '{{description}}')" data-bs-toggle="modal" data-bs-target="#editModal">
            <i class="bi bi-pencil-fill text-gray"></i>
          </button>
          <button class="btn p-0" onclick="openDeleteModal(event, {{id}})" data-bs-toggle="modal" data-bs-target="#deleteModal">
            <i class="bi bi-trash3-fill text-gray"></i>
          </button>
        </div>
      </div>
      <div class="text-secondary">
        {{description}}
      </div>
    </a>
    {{else}}
    <div id="content-empty" style="grid-column: 1/-1">
      <div class="d-flex flex-column align-items-center justify-content-center mt-5">
        <img src="/assets/empty_box.png" height="140px" width="140px" />
        <div class="fw-semibold fs-2" style="color: #9FAAC0">It’s empty. Create something new</div>
      </div>
    </div>
	{{/each}}
</script>
{{{{/rawHelper}}}}

{{{{rawHelper}}}}
<script id="template-release-filter" type="text/x-handlebars-template">
	{{#each releases}}
    <button class="dropdown-item" onclick="currentFilter = {{id}}; loadRequirement(1)">{{name}}</button>
	{{/each}}
</script>
{{{{/rawHelper}}}}

{{{{rawHelper}}}}
<script id="template-release-select" type="text/x-handlebars-template">
	{{#each releases}}
    <option value="{{id}}">{{name}}</option>
	{{/each}}
</script>
{{{{/rawHelper}}}}

{{{{rawHelper}}}}
<script id="template-testcase" type="text/x-handlebars-template">
	{{#each data}}
    <a href="{{href}}" class="text-decoration-none bg-white rounded bottom-shadow p-2">
      {{name}}
    </a>
	{{/each}}
</script>
{{{{/rawHelper}}}}

<script>
let template_requirement = Handlebars.compile(document.getElementById('template-requirement').innerHTML);
let template_pagination = Handlebars.compile(document.getElementById('template-pagination').innerHTML);
let template_release_filter = Handlebars.compile(document.getElementById('template-release-filter').innerHTML);
let template_release_select = Handlebars.compile(document.getElementById('template-release-select').innerHTML);
let template_testcase = Handlebars.compile(document.getElementById('template-testcase').innerHTML);

let currentPage = parseInt(getUrlQuery('page')) || 1;
currentPage = currentPage > 0 ? currentPage : 1;

let currentFilter = '';
let currentSearch = '';

{{#if requirementId}}
  const PAGE_SIZE = 4;
{{else}}
  const PAGE_SIZE = 8;
{{/if}}


function clearRequirement() {
	document.getElementById('requirements').innerHTML = '';
	document.getElementById('pagination').innerHTML = '';
}

function searchOnInput() {
	let keyword = document.getElementById('search').value;
	currentSearch = keyword;
	loadRequirement(1);
}

function populateReleases() {
  axiosAPI.get('/api/projects/{{projectId}}/releases')
  .then(res => {
    let filter = template_release_filter({
      releases: res.data.releases
    })
    let select = template_release_select({
      releases: res.data.releases
    })
    document.getElementById('filter').innerHTML += filter;
    document.querySelector('#create-requirement-form #release').innerHTML += select;
  }).catch(err => {
    console.log(err)
  })
}

function loadRequirement(page = 1, size = PAGE_SIZE) {
  let url = '/api/projects/{{projectId}}/requirements'
  {{#if requirementId}}
    url += '/{{requirementId}}'
  {{/if}}
  axiosAPI.get(url, {
		params: {
			page: page,
			size: size,
			filter: currentFilter,
			search: currentSearch,
		}
	})
  .then(res => {
    if (page > res.data.numPage) {
			loadRequirement(res.data.numPage);
			return;
		}
		clearRequirement();
		setUrlQuery('page', page)
    {{#if requirementId}}
      const rqData = res.data.data.childRequirements;
      if (res.data.data.parentRequirementId)
        document.getElementById('back').href = '/project/{{projectId}}/requirement/' + res.data.data.parentRequirementId;
      else
        document.getElementById('back').href = '/project/{{projectId}}/requirement';
    {{else}}
      const rqData = res.data.requirements;
    {{/if}}
    rqData.forEach(rq => {
      rq.projectId = {{projectId}}
    })
    let requirements = template_requirement({
      data: rqData
    })
		document.getElementById('requirements').innerHTML += requirements;
    
  
    {{#if requirementId}}
      const tcData = res.data.data.testCases;
      tcData.forEach(tc => {
        tc.href = "/project/{{projectId}}/test_case/" + tc.id;
      })
      let testCases = template_testcase({
        data: tcData
      })
      document.getElementById('testCases').innerHTML += testCases;

    {{/if}}

		makePagination(res.data.numPage, page);
  })
  .catch(err => {
    console.log(err)
  })
}

loadRequirement()
populateReleases();

function makePagination(numPage, currentPage) {
	let opts = [];

	let start = currentPage - 2;
	let end = currentPage + 2;

	if (start < 1) {
		start = 1
		end = Math.min(numPage, 5)
	}
	else if (end > numPage) {
		end = numPage
		start = Math.max(1, numPage - 4)
	}
	
	for (let i = start; i <= end; i++) {
		opts.push({
			text: i,
			onclick: `loadRequirement(${i})`,
			currentPage: currentPage == i
		})
	}

	let html = template_pagination({
		currentPage: currentPage,
		pages: opts
	})
	document.getElementById('pagination').innerHTML = html;
	document.getElementById('previousPage').onclick = currentPage == 1 ? null : () => {loadRequirement(currentPage - 1)};
	document.getElementById('nextPage').onclick = currentPage == numPage ? null : () => {loadRequirement(currentPage + 1)};
}

function openEditModal(e, id, name, description) {
  e.preventDefault();
  e.stopPropagation();
  document.querySelector("#edit-requirement-form #name").value = name;
  document.querySelector("#edit-requirement-form #id").value = id;
  document.querySelector("#edit-requirement-form #description").value = description;
}

function openDeleteModal(e, id) {
  e.preventDefault();
  e.stopPropagation();
  document.querySelector("#delete-requirement-form #id").value = id;
}

function editRequirement(e) {
  e.preventDefault()
	e.stopPropagation()
	var form = document.getElementById('edit-requirement-form');
	if (!form.checkValidity()) {
		form.classList.add('was-validated')
		return;
	}
	form.classList.remove('was-validated')

	var myModalEl = document.getElementById('editModal');
	var modal = bootstrap.Modal.getInstance(myModalEl);
	
	var name = document.querySelector("#edit-requirement-form #name");
	var id = document.querySelector("#edit-requirement-form #id");
	var description = document.querySelector("#edit-requirement-form #description");

	axiosAPI.put('/api/projects/{{projectId}}/requirements/' + id.value, {
		name: name.value,
    description: description.value,
	})
	.then(res => {
		console.log(res);
		Toastify({
			text: "Succesfully edited requirement",
			style: {
			background: "linear-gradient(to right, #198754, #198754)",
			},
			onClick: function(){} // Callback after click
		}).showToast();
		modal.hide();
    
    //Clear form
    name.value = "";
    id.value = "";
    description.value = "";
		setTimeout(() => {
			window.location.reload();
		}, 500);
	})
	.catch(err => {
		console.log(err);
		Toastify({
			text: "Failed to change requirement",
			style: {
			background: "linear-gradient(to right, #dc3545, #dc3545)",
			},
			onClick: function(){} // Callback after click
		}).showToast();
	})
}

function deleteRequirement(e) {
  e.preventDefault()
  e.stopPropagation();

  var myModalEl = document.getElementById('deleteModal');
	var modal = bootstrap.Modal.getInstance(myModalEl);
	
	var id = document.querySelector("#delete-requirement-form #id");

  axiosAPI.delete('/api/projects/{{projectId}}/requirements/' + id.value)
    .then(res => {
      console.log(res);
      Toastify({
        text: "Deleted",
        style: {
        background: "linear-gradient(to right, #198754, #198754)",
        },
        onClick: function(){} // Callback after click
      }).showToast();
      setTimeout(() => {
        window.location.reload();
      }, 500);
    })
    .catch(err => {
      console.log(err);
      Toastify({
        text: "Failed to delete requirement",
        style: {
        background: "linear-gradient(to right, #dc3545, #dc3545)",
        },
        onClick: function(){} // Callback after click
      }).showToast();
    })
}

function createRequirement(e) {
	e.preventDefault()
	e.stopPropagation()
	var form = document.getElementById('create-requirement-form');
	if (!form.checkValidity()) {
		form.classList.add('was-validated')
		return;
	}
	form.classList.remove('was-validated')

	var myModalEl = document.getElementById('createModal');
	var modal = bootstrap.Modal.getInstance(myModalEl);

	var name = document.getElementById('name');
	var description = document.getElementById('description');
	var release = document.getElementById('release');
	var parentId = document.getElementById('parentRequirementId');

  axiosAPI.post('/api/projects/{{projectId}}/requirements', {
    releaseId: release.value,
    name: name.value,
    description: description.value,
    parentRequirementId: parentId.value,
  })
  .then(res => {
		console.log(res);
		Toastify({
			text: "New requirement created",
			style: {
			background: "linear-gradient(to right, #198754, #198754)",
			},
			onClick: function(){} // Callback after click
		}).showToast();
		modal.hide();

    //Clear form
    name.value = "";
    description.value = "";
    release.value = "";
		setTimeout(() => {
			window.location.reload();
		}, 500);
	})
	.catch(err => {
		console.log(err);
		Toastify({
			text: "Failed to create requirement",
			style: {
			background: "linear-gradient(to right, #dc3545, #dc3545)",
			},
			onClick: function(){} // Callback after click
		}).showToast();
	})
}
</script>