{{#*inline "sidebarLink"}}
	<a href="/project/{{projectId}}/{{href}}" class="{{#equal currentTab name}}bg-tinted-gray{{/equal}} text-decoration-none d-flex align-items-center rounded p-2" style="width: 80%;">
		{{#if imgSrc}}
			<img src="{{imgSrc}}" alt="#" height="30" class="">
		{{/if}}
		{{#if icon}}
			<i class="{{icon}} text-gray px-1"></i>
		{{/if}}
		<span class="align-middle text-gray fw-semibold px-1 .d-none .d-md-block">
			{{name}}
		</span>
	</a>
{{/inline}}

<div id="sidebar" class="overflow-auto border border-top-0 border-start-0 border-bottom-0 border-3" style="width: 20%; ">
	<a href="/project" id="project-info" class="sticky-top text-decoration-none d-flex bottom-shadow bg-white">
		<div class="d-flex align-items-center justify-content-between w-100 p-4 px-3">
			<div class="d-flex align-items-center gap-2 minw-0">
				<div class="bg-divisor-gray rounded">
					<img src="/assets/project_placeholder.png" height="32px" alt="Project Image">
				</div>
				<div class="d-flex flex-column lh-sm minw-0">
					<div class="fw-semibold text-gray fs-5 text-truncate" id="sidebar-project-name">
						{{projectName}}
					</div>
					<div class="text-secondary fs-6">
						{{roleName}}
					</div>
				</div>
			</div>
			<div>
				<i class="bi bi-chevron-down text-gray" alt="Change project"></i>
			</div>
		</div>
	</a>
	<div id="tabs" class="overflow-auto d-flex gap-3 py-4 flex-column align-items-center justify-content-center">
		{{#allowRoleFrom role 'admin'}}
			{{> sidebarLink href="dashboard" icon="bi bi-speedometer" name="Dashboard"}}
		{{/allowRoleFrom}}
		{{#allowRoleFrom role 'tester'}}
			{{> sidebarLink href="overview" icon="bi bi-house-fill" name="Overview"}}
			{{> sidebarLink href="requirement" icon="bi bi-ui-checks" name="Requirements"}}
			{{> sidebarLink href="module" icon="bi bi-box-seam-fill" name="Modules"}}
			{{> sidebarLink href="release" icon="bi bi-rocket-takeoff-fill" name="Releases"}}
			<div class="bg-divisor-gray rounded-pill" style="height: 3px; width: 80%;"></div>

			{{> sidebarLink href="test_case" icon="bi bi-clipboard-check-fill" name="Test Cases"}}
			{{> sidebarLink href="test_plan" icon="bi bi-kanban-fill" name="Test Plans"}}
			{{> sidebarLink href="test_run" icon="bi bi-clipboard-data-fill" name="Test Runs"}}
		{{/allowRoleFrom}}

		{{> sidebarLink href="issue" icon="bi bi-chat-left-text-fill" name="Issues"}}
		
	</div>
</div>

<script>


</script>