{{#> modal id='createModal'}}
<div class="d-flex flex-column p-4 gap-4">
  <div class="d-flex align-items-center justify-content-between">
    <div class="fw-semibold text-gray fs-3">
      Create new issue
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
  </div>

  <form id="create-issue-form" class="needs-validation" onsubmit="return createIssue(event)" novalidate>
    <div class="mb-3">
      <label for="name" class="form-label text-gray">Name</label>
      <input type="text" class="form-control" id="name" placeholder="Foobar" required>
      <div class="invalid-feedback">
        Please provide a valid name.
      </div>
    </div>
    <div class="mb-3">
      <label for="start-date" class="form-label text-gray">Priority</label>
      <select id="priority" class="form-select" required>
        <option value="" disabled selected>Priority...</option>
        <option value="low">low</option>
        <option value="medium">medium</option>
        <option value="high">high</option>
      </select>
      <div class="invalid-feedback">
        Please choose priority.
      </div>
    </div>
    <div class="mb-3">
      <label for="description" class="form-label text-gray">Description</label>
      <textarea class="form-control" id="description" rows="5" placeholder="Something about this issue..."></textarea>
    </div>
    <div class="mb-3">
      <label for="description" class="form-label text-gray">Test Run</label>
      <select id="testRun" class="form-select" required>
        <option value="" disabled selected>Test Run...</option>
      </select>
      <div class="invalid-feedback">
        Please choose test run.
      </div>
    </div>
    <div class="d-flex align-items-center justify-content-center gap-3">
      <button type="submit" class="btn btn-primary">Create</button>
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
  </form>
  
</div>
{{/modal}}

{{#> modal id='editModal'}}
<div class="d-flex flex-column p-4 gap-4">
  <div class="d-flex align-items-center justify-content-between">
    <div class="fw-semibold text-gray fs-3">
      Edit Issue
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
  </div>

  
  <form id="edit-issue-form" class="needs-validation" onsubmit="return editIssue(event)" novalidate>
    <div class="mb-3">
      <label for="name" class="form-label text-gray">Name</label>
      <input type="text" class="form-control" id="name" placeholder="Foobar" required>
      <div class="invalid-feedback">
        Please provide a valid name.
      </div>
    </div>
    <div class="mb-3">
      <label for="start-date" class="form-label text-gray">Priority</label>
      <select id="priority" class="form-select" required>
        <option value="" disabled selected>Priority...</option>
        <option value="low">low</option>
        <option value="medium">medium</option>
        <option value="high">high</option>
      </select>
      <div class="invalid-feedback">
        Please choose priority.
      </div>
    </div>
    <div class="mb-3">
      <label for="start-date" class="form-label text-gray">Status</label>
      <select id="status" class="form-select" required>
        <option value="" disabled selected>Status...</option>
        <option value="open">Open</option>
        <option value="closed">Closed</option>
      </select>
      <div class="invalid-feedback">
        Please choose status.
      </div>
    </div>
    <div class="mb-3">
      <input type="text" class="form-control" id="id" hidden required>
    </div>
    <div class="mb-3">
      <label for="description" class="form-label text-gray">Description</label>
      <textarea class="form-control" id="description" rows="5" placeholder="Something about this issue..."></textarea>
    </div>
    <div class="d-flex align-items-center justify-content-center gap-3">
      <button type="submit" class="btn btn-primary">Edit</button>
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
  </form>
  
</div>
{{/modal}}

{{#> modal id='deleteModal'}}
<div class="d-flex flex-column p-4 gap-4">
  <div class="d-flex align-items-center justify-content-between">
    <div class="fw-semibold text-gray fs-3">
      Delete Release
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
  </div>

  
  <form id="delete-issue-form" class="needs-validation" onsubmit="return deleteIssue(event)" novalidate>
    <div class="mb-3">
      <input type="text" class="form-control" id="id" hidden required>
      Are you sure you want to delete this issue?
    </div>
    <div class="d-flex align-items-center justify-content-center gap-3">
      <button type="submit" class="btn btn-danger">Delete</button>
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
  </form>
  
</div>
{{/modal}}

