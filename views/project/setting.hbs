{{#> modal id='renameModal'}}
<div class="d-flex flex-column p-4 gap-4">
  <div class="d-flex align-items-center justify-content-between">
    <div class="fw-semibold text-gray fs-3">
      Rename Project
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
  </div>

  <form id="edit-project-form" class="needs-validation" onsubmit="return renameProject(event)" novalidate>
    <div class="mb-3">
      <label for="name" class="form-label text-gray">Project Name</label>
      <input type="text" class="form-control" id="name" placeholder="Foobar" required>
      <div class="invalid-feedback">
        Please provide a valid name.
      </div>
    </div>
    <div class="d-flex align-items-center justify-content-center gap-3">
      <button type="submit" class="btn btn-primary">Rename</button>
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
  </form>
</div>
{{/modal}}

{{#> modal id='deleteModal'}}
<div class="d-flex flex-column p-4 gap-4">
  <div class="d-flex align-items-center justify-content-between">
    <div class="fw-semibold text-gray fs-3">
      Delete Project
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
  </div>

  <form id="delete-project-form" class="needs-validation" onsubmit="return deleteProject(event)" novalidate>
    <div class="mb-3">
      Are you sure you want to delete this project?
    </div>
    <div class="d-flex align-items-center justify-content-center gap-3">
      <button type="submit" class="btn btn-danger">Delete</button>
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
  </form>
  
</div>
{{/modal}}

{{#> modal id='addUserModal'}}
<div class="d-flex flex-column p-4 gap-4">
  <div class="d-flex align-items-center justify-content-between">
    <div class="fw-semibold text-gray fs-3">
      Assign User
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
  </div>

  <form id="add-user-form" class="needs-validation" novalidate onsubmit="return addUserRole(event)">
    <div class="mb-3">
      <label for="usernameAssign" class="form-label text-gray">Select User</label>
      <input type="text" class="form-control" id="usernameAssign" placeholder="Username" required oninput="assignUser()">
      <ul class="list-group position-absolute w-100 mt-1" id="suggestions" style="z-index: 1000;"></ul>
      <div class="invalid-feedback">
        Please provide a valid username.
      </div>
    </div>
    <div class="mb-3">
      <label for="roleAssign" class="form-label text-gray">Select Role</label>
      <select id="roleAssign" class="form-select" required>
        <option value="" disabled selected>Role...</option>
        <option value="manager">Manager</option>
        <option value="tester">Tester</option>
        <option value="developer">Developer</option>
      </select>
      <div class="invalid-feedback">
        Please select a valid role.
      </div>
    </div>
    <div class="d-flex align-items-center justify-content-center gap-3">
      <button type="submit" class="btn btn-primary">Assign</button>
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
  </form>
</div>
{{/modal}}

{{#> modal id='editUserModal'}}
<div class="d-flex flex-column p-4 gap-4">
  <div class="d-flex align-items-center justify-content-between">
    <div class="fw-semibold text-gray fs-3">
      Change User Role
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
  </div>

  <form id="edit-user-form" class="needs-validation" onsubmit="return changeUserRole(event)" novalidate>
    <div class="mb-3">
      <input type="text" class="form-control" id="username" hidden required>
    </div>
    <div class="mb-3">
    <label for="roleAssign" class="form-label text-gray">Select Role</label>
    <select id="roleAssign" class="form-select" required>
      <option value="" disabled selected>Role...</option>
      <option value="manager">Manager</option>
      <option value="tester">Tester</option>
      <option value="developer">Developer</option>
    </select>
    <div class="invalid-feedback">
      Please select a valid role.
    </div>
  </div>
    <div class="d-flex align-items-center justify-content-center gap-3">
      <button type="submit" class="btn btn-primary">Change</button>
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
  </form>
</div>
{{/modal}}

{{#> modal id='deleteUserModal'}}
<div class="d-flex flex-column p-4 gap-4">
  <div class="d-flex align-items-center justify-content-between">
    <div class="fw-semibold text-gray fs-3">
      Remove user from project
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
  </div>

  <form id="delete-user-form" class="needs-validation" onsubmit="return removeUserRole(event)" novalidate>
    <div class="mb-3">
      <input type="text" class="form-control" id="username" hidden required>
      Are you sure you want to remove this user from the project?
    </div>
    <div class="d-flex align-items-center justify-content-center gap-3">
      <button type="submit" class="btn btn-danger">Remove</button>
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
  </form>
</div>
{{/modal}}

<main class="d-flex h-100 overflow-hidden">
  {{>sidebar}}
  <div id="content" class="h-100 overflow-auto p-4" style="width: 80%; ">
    <div class="text-gray fw-semibold fs-4 pb-3">
			Project Settings
		</div>
    <div class="d-flex gap-2">
      <button type="button" class="btn btn-primary d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#renameModal">
        <i class="bi bi-pencil-square text-white"></i>
        <div>Rename Project</div>
      </button>
      <button type="button" class="btn btn-danger d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#deleteModal">
        <i class="bi bi-trash3-fill text-white"></i>
        <div>Delete Project</div>
      </button>
    </div>

    <div class="text-gray fw-semibold fs-4 py-3">
			Project Members
		</div>

    <button type="button" class="btn btn-primary d-flex align-items-center mb-3 gap-2" data-bs-toggle="modal" data-bs-target="#addUserModal">
      <i class="bi bi-person-fill-add text-white"></i>
      <div>Assign User</div>
    </button>

    <div id="members" class="d-grid gap-2 project-grid-cols-1 sm:project-grid-cols-2 md:project-grid-cols-4">

    </div>
  </div>
</main>

{{{{rawHelper}}}}
<script id="template-member" type="text/x-handlebars-template">
{{#each members}}
  <div class="bg-white rounded rounded bottom-shadow p-3">
    <div class="d-flex justify-content-between">
      <div class="d-flex align-items-center gap-1">
        <i class="bi bi-person-circle text-gray"></i>
        <div class="text-gray fw-bold">{{fullName}}</div>
      </div>
      <div class="d-flex gap-1">
        <button class="btn p-0" onclick="openEditUser(event, '{{username}}', '{{role}}')" data-bs-toggle="modal" data-bs-target="#editUserModal">
          <i class="bi bi-pencil-fill text-gray"></i>
        </button>
        <button class="btn p-0" onclick="openDeleteUser(event, '{{username}}')" data-bs-toggle="modal" data-bs-target="#deleteUserModal">
          <i class="bi bi-x-circle-fill text-gray"></i>
        </button>
      </div>
    </div>
    <div class="text-gray">{{roleName}}</div>
  </div>
{{/each}}
</script>
{{{{/rawHelper}}}}

<script>
let template_member = Handlebars.compile(document.getElementById('template-member').innerHTML);

function openEditUser(e, username, role) {
  e.preventDefault();
  e.stopPropagation();
  document.querySelector("#edit-user-form #username").value = username;
  document.querySelector("#edit-user-form #roleAssign").value = role;
}

function openDeleteUser(e, username) {
  e.preventDefault();
  e.stopPropagation();
  document.querySelector("#delete-user-form #username").value = username;
}

function addUserRole(e) {
	e.preventDefault()
	e.stopPropagation()
	var form = document.getElementById('add-user-form');
	if (!form.checkValidity()) {
		form.classList.add('was-validated')
		return;
	}
	form.classList.remove('was-validated')

	var myModalEl = document.getElementById('addUserModal');
	var modal = bootstrap.Modal.getInstance(myModalEl);
	
	var username = document.querySelector("#add-user-form #usernameAssign");
  var role = document.querySelector('#add-user-form #roleAssign');

  axiosAPI.post('/api/projects/{{projectId}}/members', {
    username: username.value,
    role: role.value,
  })
  .then(res => {
		Toastify({
			text: "Successfully assign user",
			style: {
			background: "linear-gradient(to right, #198754, #198754)",
			},
			onClick: function(){} // Callback after click
		}).showToast();
    modal.hide();
    username.value = '';
    role.value = '';
		setTimeout(() => {
			window.location.reload();
		}, 500);
	})
	.catch(err => {
		console.log(err);
		Toastify({
			text: "Failed to assign user: " + err?.response?.data?.message,
			style: {
			background: "linear-gradient(to right, #dc3545, #dc3545)",
			},
			onClick: function(){} // Callback after click
		}).showToast();
	})
}


function changeUserRole(e) {
  e.preventDefault()
	e.stopPropagation()
	var form = document.getElementById('edit-user-form');
	if (!form.checkValidity()) {
		form.classList.add('was-validated')
		return;
	}
	form.classList.remove('was-validated')

	var myModalEl = document.getElementById('editUserModal');
	var modal = bootstrap.Modal.getInstance(myModalEl);
	
	var username = document.querySelector("#edit-user-form #username");
	var role = document.querySelector("#edit-user-form #roleAssign");

	axiosAPI.put('/api/projects/{{projectId}}/members', {
		username: username.value,
    role: role.value
	})
	.then(res => {
		console.log(res);
		Toastify({
			text: "Succesfully change user role",
			style: {
			background: "linear-gradient(to right, #198754, #198754)",
			},
			onClick: function(){} // Callback after click
		}).showToast();
		modal.hide();
    
    //Clear form
    username.value = "";
    role.value = "";
		setTimeout(() => {
			window.location.reload();
		}, 500);
	})
	.catch(err => {
		console.log(err);
		Toastify({
			text: "Failed to change user role",
			style: {
			background: "linear-gradient(to right, #dc3545, #dc3545)",
			},
			onClick: function(){} // Callback after click
		}).showToast();
	})
}

function removeUserRole(e) {
  e.preventDefault()
	e.stopPropagation()
	var form = document.getElementById('delete-user-form');
	if (!form.checkValidity()) {
		form.classList.add('was-validated')
		return;
	}
	form.classList.remove('was-validated')

	var myModalEl = document.getElementById('deleteUserModal');
	var modal = bootstrap.Modal.getInstance(myModalEl);
	
	var username = document.querySelector("#delete-user-form #username");

	axiosAPI.delete('/api/projects/{{projectId}}/members', {
    data: {
      username: username.value,
    }
	})
	.then(res => {
		console.log(res);
		Toastify({
			text: "Succesfully remove user",
			style: {
			background: "linear-gradient(to right, #198754, #198754)",
			},
			onClick: function(){} // Callback after click
		}).showToast();
		modal.hide();
    
    //Clear form
    username.value = "";
		setTimeout(() => {
			window.location.reload();
		}, 500);
	})
	.catch(err => {
		console.log(err);
		Toastify({
			text: "Failed to remove user",
			style: {
			background: "linear-gradient(to right, #dc3545, #dc3545)",
			},
			onClick: function(){} // Callback after click
		}).showToast();
	})
}

function loadMembers(page = 1, size = 10) {
  axiosAPI.get('/api/projects/{{projectId}}/members')
  .then(res => {
    res.data.forEach(mb => {
      mb.roleName = capitalizeFirstLetter(mb.role);
      mb.username = mb.user.username;
      mb.fullName = mb.user.fullName;
      mb.avatar = mb.user.avatar;
      mb.id = mb.user.id;
    })
    let member = template_member({
      members: res.data
    })
    document.getElementById('members').innerHTML = member;
  })
  .catch(err => {
    console.log(err);
  })
}

loadMembers(1);

function renameProject(e) {
  e.preventDefault()
	e.stopPropagation()
	var form = document.getElementById('edit-project-form');
	if (!form.checkValidity()) {
		form.classList.add('was-validated')
		return;
	}
	form.classList.remove('was-validated')

	var myModalEl = document.getElementById('renameModal');
	var modal = bootstrap.Modal.getInstance(myModalEl);
	
	var name = document.querySelector("#edit-project-form #name");

	axiosAPI.put('/api/projects/{{projectId}}', {
		name: name.value,
	})
	.then(res => {
		console.log(res);
		Toastify({
			text: "Succesfully renamed project",
			style: {
			background: "linear-gradient(to right, #198754, #198754)",
			},
			onClick: function(){} // Callback after click
		}).showToast();
		modal.hide();
    
    //Clear form
    name.value = "";
		setTimeout(() => {
			window.location.reload();
		}, 500);
	})
	.catch(err => {
		console.log(err);
		Toastify({
			text: "Failed to rename project",
			style: {
			background: "linear-gradient(to right, #dc3545, #dc3545)",
			},
			onClick: function(){} // Callback after click
		}).showToast();
	})
}

function deleteProject(e) {
  e.preventDefault()
  e.stopPropagation();

  var myModalEl = document.getElementById('deleteModal');
	var modal = bootstrap.Modal.getInstance(myModalEl);
	
  axiosAPI.delete('/api/projects/{{projectId}}')
    .then(res => {
      console.log(res);
      Toastify({
        text: "Successfully deleted project",
        style: {
        background: "linear-gradient(to right, #198754, #198754)",
        },
        onClick: function(){} // Callback after click
      }).showToast();
      setTimeout(() => {
        window.location.replace('/project');
      }, 500);
    })
    .catch(err => {
      console.log(err);
      Toastify({
        text: "Failed to delete project",
        style: {
        background: "linear-gradient(to right, #dc3545, #dc3545)",
        },
        onClick: function(){} // Callback after click
      }).showToast();
    })
}

async function assignUser() {
  const input = document.getElementById('usernameAssign');
  let el = document.getElementById('usernameAssign');
  const suggestions = document.getElementById('suggestions');
  suggestions.innerHTML = '';

  let username = el.value.trim();
  if (username.length < 2) {
    return;
  }

  try {
    const res = await axiosAPI.get('/api/users/search', {
      params: {
        username: username
      }
    });
    const users = res.data?.data;
    if (users && users.length > 0) {
      users.forEach(user => {
        const li = document.createElement('li');
        li.textContent = user.username;
        li.classList.add('list-group-item');
        li.onclick = () => {
          input.value = user.username;
          suggestions.innerHTML = '';
        };
        suggestions.appendChild(li);
      });
    }
  } catch (err) {
    console.error('Error fetching users: ', err);
  }
}


</script>