{{#> modal id='createModal'}}
<div class="d-flex flex-column p-4 gap-4">
  <div class="d-flex align-items-center justify-content-between">
    <div class="fw-semibold text-gray fs-3">
      Create new Release
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
  </div>

  
  <form id="create-release-form" class="needs-validation" onsubmit="return createRelease(event)" novalidate>
    <div class="mb-3">
      <label for="name" class="form-label text-gray">Release Name</label>
      <input type="text" class="form-control" id="name" placeholder="Foobar" required>
      <div class="invalid-feedback">
        Please provide a valid name.
      </div>
    </div>
    <div class="mb-3 d-flex gap-2">
      <div class="w-50">
        <label for="start-date" class="form-label text-gray">Start Date</label>
        <input type="date" class="form-control" id="startDate" required>
        <div class="invalid-feedback">
          Please provide a valid date.
        </div>
      </div>
      <div class="w-50">
        <label for="end-date" class="form-label text-gray">End Date</label>
        <input type="date" class="form-control" id="endDate" required>
        <div class="invalid-feedback">
          Please provide a valid date.
        </div>
      </div>
    </div>
    <div class="d-flex align-items-center justify-content-center gap-3">
      <button type="submit" class="btn btn-primary">Create</button>
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
  </form>
  
</div>
{{/modal}}

{{#> modal id='editModal'}}
<div class="d-flex flex-column p-4 gap-4">
  <div class="d-flex align-items-center justify-content-between">
    <div class="fw-semibold text-gray fs-3">
      Edit Release
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
  </div>

  
  <form id="edit-release-form" class="needs-validation" onsubmit="return editRelease(event)" novalidate>
    <div class="mb-3">
      <label for="name" class="form-label text-gray">Release Name</label>
      <input type="text" class="form-control" id="name" placeholder="Foobar" required>
      <div class="invalid-feedback">
        Please provide a valid name.
      </div>
    </div>
    <div class="mb-3 d-flex gap-2">
      <div class="w-50">
        <label for="start-date" class="form-label text-gray">Start Date</label>
        <input type="date" class="form-control" id="startDate" required>
        <div class="invalid-feedback">
          Please provide a valid date.
        </div>
      </div>
      <div class="w-50">
        <label for="end-date" class="form-label text-gray">End Date</label>
        <input type="date" class="form-control" id="endDate" required>
        <div class="invalid-feedback">
          Please provide a valid date.
        </div>
      </div>
    </div>
    <div class="mb-3">
      <input type="text" class="form-control" id="id" hidden required>
    </div>
    <div class="d-flex align-items-center justify-content-center gap-3">
      <button type="submit" class="btn btn-primary">Edit</button>
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
  </form>
  
</div>
{{/modal}}

{{#> modal id='deleteModal'}}
<div class="d-flex flex-column p-4 gap-4">
  <div class="d-flex align-items-center justify-content-between">
    <div class="fw-semibold text-gray fs-3">
      Delete Release
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
  </div>

  
  <form id="delete-release-form" class="needs-validation" onsubmit="return deleteRelease(event)" novalidate>
    <div class="mb-3">
      <input type="text" class="form-control" id="id" hidden required>
      Are you sure you want to delete this release?
    </div>
    <div class="d-flex align-items-center justify-content-center gap-3">
      <button type="submit" class="btn btn-danger">Delete</button>
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
  </form>
  
</div>
{{/modal}}

<main class="d-flex h-100 overflow-hidden">
  {{>sidebar}}
  <div id="content" class="h-100 overflow-auto p-4" style="width: 80%; ">
    <button type="button" class="btn btn-success d-flex align-items-center" data-bs-toggle="modal" data-bs-target="#createModal">
      <i class="bi bi-plus-lg text-white h5 m-0"></i>
      <div>Add Releases</div>
    </button>

    <div class="d-flex justify-content-between py-3">
    </div>

    

    <div id="releases" class="d-flex flex-column gap-2">
    </div>

  </div>
</main>

<script>
  const handleDropdownButtonClick = (releaseId) => {
    const container = document.getElementById(`releaseDetails-${releaseId}`);
    if (container.innerHTML.trim() !== '') return;
    const releaseDetails = axiosAPI.get(`/api/projects/{{projectId}}/releases/${releaseId}/details`)
      .then(res => res.data?.data)
      .then(data => {

        const createdAtDiv = document.createElement('div');
        createdAtDiv.innerHTML = `<strong>Start:</strong> ` + dayjs(data.startDate).format('DD/MM/YYYY');
        container.appendChild(createdAtDiv);

        const endAtDiv = document.createElement('div');
        endAtDiv.innerHTML = `<strong>End:</strong> ` + dayjs(data.endDate).format('DD/MM/YYYY');
        container.appendChild(endAtDiv);

        const requirementCount = data.requirements.length;
        let testCaseCount = 0;
        let testRunCount = 0;

        data.requirements.forEach((requirement) => {
          testCaseCount += requirement.testCases.length;
          requirement.testCases.forEach((testCase) => {
            testRunCount += testCase.testRuns.length;
          });
        });

        const testCaseCountDiv = document.createElement('div');
        testCaseCountDiv.innerHTML = `<strong>Number of test cases:</strong> ${testCaseCount}`;
        container.appendChild(testCaseCountDiv);

        const testRunCountDiv = document.createElement('div');
        testRunCountDiv.innerHTML = `<strong>Number of test runs:</strong> ${testCaseCount}`;
        container.appendChild(testRunCountDiv);
      })
      .catch(err => {
        console.error(err);
      })
  }
</script>

{{{{rawHelper}}}}
<script id="template-release" type="text/x-handlebars-template">
	{{#each data}}
    <div class="d-flex flex-column bg-white rounded bottom-shadow px-3 py-3">
      <div class="d-flex justify-content-between gap-5 align-items-center">
        <div class="d-flex align-items-center gap-2">
          <div>
            <i class="bi bi-rocket-takeoff text-gray"></i>
          </div>
          <div class="text-gray fw-semibold">
            {{name}}
          </div>
        </div>
        <div class="d-flex gap-3 align-items-center w-75">
          <div class="flex-grow-1">
            <div class="progress rounded-pill">
              <div class="progress-bar" role="progressbar" style="width: {{value}}%;" aria-valuenow="{{value}}" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
          </div>
          <div class="text-gray fw-bold">
            {{value}}%
          </div>
          <button class="btn p-0" data-bs-toggle="collapse" data-bs-target="#collapsedDescription{{id}}">
            <i class="bi bi-chevron-down text-gray" onclick="handleDropdownButtonClick({{id}})"></i>
          </button>
        </div>
      </div>
      <div class="text-secondary collapse pt-2" id="collapsedDescription{{id}}">
        <div class="d-flex justify-content-end">
          <div class="d-flex gap-1">
            <button class="btn p-0" onclick="openEditModal(event, {{id}}, '{{name}}', '{{startDate}}', '{{endDate}}')" data-bs-toggle="modal" data-bs-target="#editModal">
              <i class="bi bi-pencil-fill text-gray"></i>
            </button>
            <button class="btn p-0" onclick="openDeleteModal(event, {{id}})" data-bs-toggle="modal" data-bs-target="#deleteModal">
              <i class="bi bi-trash3-fill text-gray"></i>
            </button>
          </div>
        </div>

        <div id="releaseDetails-{{id}}">

        </div>
      </div>
      
    </div>
    {{else}}
    <div id="content-empty">
      <div class="d-flex flex-column align-items-center justify-content-center mt-5">
        <img src="/assets/empty_box.png" height="140px" width="140px" />
        <div class="fw-semibold fs-2" style="color: #9FAAC0">It’s empty. Create something new</div>
      </div>
    </div>
	{{/each}}
</script>
{{{{/rawHelper}}}}

<script>
let template = Handlebars.compile(document.getElementById('template-release').innerHTML);

function deleteRelease(id) {
  if (confirm("Do you want to delete this release?") == true) {
    axiosAPI.delete('/api/projects/{{projectId}}/releases/' + id)
    .then(res => {
      console.log(res);
      Toastify({
        text: "Deleted",
        style: {
        background: "linear-gradient(to right, #198754, #198754)",
        },
        onClick: function(){} // Callback after click
      }).showToast();
      setTimeout(() => {
        window.location.reload();
      }, 500);
    })
    .catch(err => {
      console.log(err);
      Toastify({
        text: "Failed to delete release",
        style: {
        background: "linear-gradient(to right, #dc3545, #dc3545)",
        },
        onClick: function(){} // Callback after click
      }).showToast();
    })
  }
}

function loadReleases() {
  axiosAPI.get('/api/projects/{{projectId}}/releases')
  .then(res => {
    res.data.releases.forEach((re, i) => {
      let startTime = new Date(re.startDate).getTime();
      let endTime = new Date(re.endDate).getTime();
      let currentTime = new Date().getTime();

      let percentage = Math.floor((currentTime - startTime) / (endTime - startTime) * 100);

      percentage = Math.min(Math.max(percentage, 0), 100);;
      re.value = percentage;
    })
    let html = template({
			data: res.data.releases,
		})
		document.getElementById('releases').innerHTML += html;
  })
  .catch(err => {
    console.log(err);
  })
}

loadReleases();

function createRelease(e) {
	e.preventDefault()
	e.stopPropagation()
	var form = document.getElementById('create-release-form');
	if (!form.checkValidity()) {
		form.classList.add('was-validated')
		return;
	}
	form.classList.remove('was-validated')

	var myModalEl = document.getElementById('createModal');
	var modal = bootstrap.Modal.getInstance(myModalEl);

	var name = document.querySelector("#create-release-form #name");
	var startDate = document.querySelector("#create-release-form #startDate");
	var endDate = document.querySelector("#create-release-form #endDate");
	var progress = Math.floor(Math.random() * 80) + 20;

  axios.post('/api/projects/{{projectId}}/releases', {
    name: name.value,
    startDate: startDate.value,
    endDate: endDate.value,
  })
  .then(res => {
		Toastify({
			text: "New release created",
			style: {
			background: "linear-gradient(to right, #198754, #198754)",
			},
			onClick: function(){} // Callback after click
		}).showToast();
		modal.hide();
    
    //Clear form
    name.value = "";
    startDate.value = "";
    endDate.value = "";
		setTimeout(() => {
			window.location.reload();
		}, 500);
	})
	.catch(err => {
		console.log(err);
		Toastify({
			text: "Failed to create release",
			style: {
			background: "linear-gradient(to right, #dc3545, #dc3545)",
			},
			onClick: function(){} // Callback after click
		}).showToast();
	})
}

function openEditModal(e, id, name, startDate, endDate) {
  e.preventDefault();
  e.stopPropagation();
  document.querySelector("#edit-release-form #name").value = name;
  document.querySelector("#edit-release-form #id").value = id;
  document.querySelector("#edit-release-form #startDate").value = startDate;
  document.querySelector("#edit-release-form #endDate").value = endDate;
}

function openDeleteModal(e, id) {
  e.preventDefault();
  e.stopPropagation();
  document.querySelector("#delete-release-form #id").value = id;
}

function editRelease(e) {
  e.preventDefault()
	e.stopPropagation()
	var form = document.getElementById('edit-release-form');
	if (!form.checkValidity()) {
		form.classList.add('was-validated')
		return;
	}
	form.classList.remove('was-validated')

	var myModalEl = document.getElementById('editModal');
	var modal = bootstrap.Modal.getInstance(myModalEl);
	
	var name = document.querySelector("#edit-release-form #name");
	var id = document.querySelector("#edit-release-form #id");
	var startDate = document.querySelector("#edit-release-form #startDate");
	var endDate = document.querySelector("#edit-release-form #endDate");

	axiosAPI.put('/api/projects/{{projectId}}/releases/' + id.value, {
		name: name.value,
    startDate: startDate.value,
    endDate: endDate.value,
	})
	.then(res => {
		console.log(res);
		Toastify({
			text: "Succesfully edited release",
			style: {
			background: "linear-gradient(to right, #198754, #198754)",
			},
			onClick: function(){} // Callback after click
		}).showToast();
		modal.hide();
    
    //Clear form
    name.value = "";
    id.value = "";
    startDate.value = "";
    endDate.value = "";
		setTimeout(() => {
			window.location.reload();
		}, 500);
	})
	.catch(err => {
		console.log(err);
		Toastify({
			text: "Failed to change requirement",
			style: {
			background: "linear-gradient(to right, #dc3545, #dc3545)",
			},
			onClick: function(){} // Callback after click
		}).showToast();
	})
}

function deleteRelease(e) {
  e.preventDefault()
  e.stopPropagation();

  var myModalEl = document.getElementById('deleteModal');
	var modal = bootstrap.Modal.getInstance(myModalEl);
	
	var id = document.querySelector("#delete-release-form #id");

  axiosAPI.delete('/api/projects/{{projectId}}/releases/' + id.value)
    .then(res => {
      console.log(res);
      Toastify({
        text: "Successfully deleted release",
        style: {
        background: "linear-gradient(to right, #198754, #198754)",
        },
        onClick: function(){} // Callback after click
      }).showToast();
      setTimeout(() => {
        window.location.reload();
      }, 500);
    })
    .catch(err => {
      console.log(err);
      Toastify({
        text: "Failed to delete release",
        style: {
        background: "linear-gradient(to right, #dc3545, #dc3545)",
        },
        onClick: function(){} // Callback after click
      }).showToast();
    })
}

</script>
